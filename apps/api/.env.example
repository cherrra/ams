DATABASE_URL="mysql://root:@127.0.0.1:3306/ams_db"
PORT=3005
API_PREFIX=api/v1
CORS_ORIGINS=*

# Сгенерируйте свои значения: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN=30d

UPLOAD_DIR=uploads
BASE_URL="http://localhost:3005"
MAX_UPLOAD_SIZE_MB=5
